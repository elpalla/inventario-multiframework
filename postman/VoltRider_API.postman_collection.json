{
  "info": {
    "name": "VoltRider - API Inventario (Slim)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecuta primero '0. Login' para guardar el token JWT en la variable {{token}}."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8081"
