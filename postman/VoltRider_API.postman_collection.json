  "item": [
    {
      "name": "0. Autenticacion",
      "item": [
        {
          "name": "Login OK (200) - guarda token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@voltrider.com\",\n  \"password\": \"Admin12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Codigo HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test('Devuelve token JWT', function(){ pm.expect(j.data.token).to.be.a('string'); });",
                  "pm.collectionVariables.set('token', j.data.token);"
                ]
              }
            }
          ]
        },
